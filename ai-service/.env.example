# LLM Provider Configuration
# Question generation: mock uses the bundled bank. The answer evaluator ignores
# this and runs the rubric path whenever LLM_API_KEY is set.
LLM_PROVIDER=mock

# API Keys (set your actual keys)
LLM_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Model Configuration. The Gemini API recommends gemini-3.5-flash-lite; each
# model has its own free-tier daily quota, so a second model is a fallback.
LLM_MODEL=gemini-3.5-flash-lite

# Speech-to-Text Provider
# Options: mock, deepgram, whisper
STT_PROVIDER=mock
DEEPGRAM_API_KEY=

# Text-to-Speech Provider
# Options: mock, edge, elevenlabs
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=

# Judge0 Code Execution
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# Service Configuration
HOST=0.0.0.0
PORT=8001

# Shared secret required from the backend (leave empty to keep the service open locally)
AI_SERVICE_TOKEN=

# Comma-separated browser origins allowed to call this service directly
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Upstash Redis REST cache. Without these two values the service uses a
# process-local TTL cache (still fast for repeated requests, not shared).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Rubric/follow-up cache TTL in seconds (default 7 days).
CACHE_TTL_SECONDS=604800


# Local speech-to-text (no paid key). Model is downloaded on first use to
# ai-service/.cache/whisper. Use "base" on CPU-only hosts.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE=./.cache/whisper

# auto = faster-whisper then Deepgram (if DEEPGRAM_API_KEY is set)
STT_PROVIDER=auto

# Offline TTS fallback: point these at a Piper binary and .onnx voice.
PIPER_BIN=piper
PIPER_MODEL=
